# ==============================================================================
# NEXUS — Supply Chain Intelligence Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google Maps Platform Maps JavaScript API Key
# Official client-side key for interactive world map, port markers, and shipping route overlays.
# To use: create frontend/.env.local (ignored by git) and set:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYourActualKeyHere"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Client-side configuration
# Note: Never place secret keys (e.g. TINYFISH_API_KEY) in client-side variables!
# All TinyFish web research requests are securely routed through the server-side backend.
