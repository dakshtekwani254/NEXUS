# ==============================================================================
# NEXUS — Supply Chain Intelligence Platform Backend Environment Variables
# ==============================================================================

# TinyFish Web Automation & Research API Key
# Sign up and retrieve your key at: https://agent.tinyfish.ai/api-keys
# The integration reads TINYFISH_API_KEY from this file or system environment variables.
# Never commit real API keys to version control.
TINYFISH_API_KEY=

# TinyFish Base URL (defaults to official API https://agent.tinyfish.ai)
TINYFISH_API_BASE_URL=https://agent.tinyfish.ai

# Optional LLM Key for AI Analyst advanced reasoning synthesis
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Port and Host (used by uvicorn)
HOST=127.0.0.1
PORT=8000
