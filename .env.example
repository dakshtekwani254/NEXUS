# ==============================================================
# NEXUS — Supply Chain Intelligence Platform Configuration
# ==============================================================

# Backend Service Port
PORT=8000
HOST=127.0.0.1

# Frontend API Base URL (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# --------------------------------------------------------------
# Autonomous Browser Crawler Integration (TinyFish)
# --------------------------------------------------------------
# If left empty, NEXUS operates in high-fidelity realistic simulation mode
# with structured DOM extraction, delta scoring, and downstream alert pipelines.
TINYFISH_API_BASE_URL=https://api.tinyfish.io/v1
TINYFISH_API_KEY=

# --------------------------------------------------------------
# Conversational AI Reasoning Engine (Optional LLM Key)
# --------------------------------------------------------------
# If left empty, NEXUS uses its built-in deterministic supply chain reasoning
# engine grounded on real database state and maritime chokepoint models.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --------------------------------------------------------------
# Meteorological & Ocean Telemetry Integration
# --------------------------------------------------------------
NOAA_WEATHER_API_KEY=
